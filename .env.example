FRESHSALES_API_KEY=replace-with-static-freshsales-api-key
FRESHSALES_DOMAIN=replace-with-static-freshsales-domain
# Both view IDs are required; the server will not start without them.
FRESHSALES_DEFAULT_CONTACTS_VIEW_ID=replace-with-contacts-view-id
FRESHSALES_DEFAULT_DEALS_VIEW_ID=replace-with-deals-view-id
OAUTH_CLIENT_ID=replace-with-static-oauth-client-id
OAUTH_CLIENT_SECRET=replace-with-static-oauth-client-secret
DAILY_CALL_LIMIT=200
APPROVAL_TTL_SECONDS=300
RESET_TIMEZONE=UTC
MCP_ALLOWED_ORIGINS=https://claude.ai
MCP_ALLOWED_HOSTS=your-service.onrender.com
FRESHSALES_MAX_429_RETRIES=1
FRESHSALES_MAX_RETRY_WAIT_MS=2000
LOCAL_RATE_LIMIT_PER_MINUTE=600
PIPELINE_SUMMARY_MAX_PAGES=5
CONTACTS_SCAN_MAX_PAGES=10
CONTACTS_SCAN_MAX_VIEWS=15
DEALS_SCAN_MAX_PAGES=10
DEALS_SCAN_MAX_VIEWS=15
FIELD_SCHEMA_CACHE_TTL_MS=86400000
ANALYTICS_REPORT_CACHE_TTL_MS=86400000
FRESHSALES_ANALYTICS_REPORTS_PATH=api/reports
FRESHSALES_ANALYTICS_REPORT_EXPORT_PATH_TEMPLATE=api/reports/{report_id}/export
FRESHSALES_ANALYTICS_EXPORT_STATUS_PATH_TEMPLATE=api/reports/exports/{export_id}
VIEW_LIST_CACHE_TTL_MS=3600000
VIEW_FIELD_COVERAGE_CACHE_TTL_MS=3600000
